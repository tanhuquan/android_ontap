<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddVerbActivity">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NHẬP TỪ MỚI"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/tvAddVerb"
        android:layout_margin="15dp"

        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/tvAddVerb"
        android:layout_margin="12sp"
        >
        <EditText
            android:layout_width="match_parent"
            android:layout_height="50sp"
            android:id="@+id/edtEnglish"
            android:hint="English"
            android:background="@drawable/anhnen"
            android:layout_margin="5dp"
            android:padding="10sp"
            />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="50sp"
            android:id="@+id/edtMeaning"
            android:hint="Meaning"
            android:background="@drawable/anhnen"
            android:layout_margin="5dp"
            android:padding="10sp"
            />
        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/rgVerbType">
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Động từ (v)"
                android:id="@+id/rbVerb"
                android:textSize="10dp"
                />
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh từ (n)"
                android:id="@+id/rbNoun"
                android:textSize="10dp"

                />
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tính từ (adj)"
                android:id="@+id/rbAdjective"
                android:textSize="10dp"
                />
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trạng từ (adv)"
                android:id="@+id/rbAdverb"
                android:textSize="10dp"
                />
        </RadioGroup>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/black"
            android:textColor="@color/white"
            android:text="Thêm"
            android:id="@+id/btnAdd"
            android:layout_margin="20dp"
            />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>